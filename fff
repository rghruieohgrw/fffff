local function rgb_to_hsv(c)
    local r, g, b = c.r, c.g, c.b
    local maxc = math.max(r, g, b)
    local minc = math.min(r, g, b)
    local h, s, v = 0, 0, maxc
    local diff = maxc - minc
    if maxc ~= 0 then s = diff / maxc else return 0, 0, 0 end
    if diff > 1e-5 then
        if maxc == r then h = (g - b) / diff
        elseif maxc == g then h = 2 + (b - r) / diff
        else h = 4 + (r - g) / diff end
        h = h / 6
        if h < 0 then h = h + 1 end
    end
    return h, s, v
end

local function hsv_to_rgb(h, s, v, a)
    local r, g, b
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 then r, g, b = v, t, p elseif i == 1 then r, g, b = q, v, p elseif i == 2 then r, g, b = p, v, t elseif i == 3 then r, g, b = p, q, v elseif i == 4 then r, g, b = t, p, v elseif i == 5 then r, g, b = v, p, q end
    return color(r, g, b, a or 1)
end

local function is_mouse_in_rect(pos, size)
    if not pos or not size then return false end
    local mouse_pos = input.get_mouse_position()
    return mouse_pos.x >= pos.x and mouse_pos.x <= pos.x + size.x and mouse_pos.y >= pos.y and mouse_pos.y <= pos.y + size.y
end

local function get_clipped_text(text, max_width)
    if render.get_text_size(text).x <= max_width then return text end
    local clipped_text = text
    while render.get_text_size(clipped_text .. "...").x > max_width and #clipped_text > 0 do
        clipped_text = string.sub(clipped_text, 1, -2)
    end
    return clipped_text .. "..."
end

local function draw_checkerboard(pos, size, square_size)
    local c1 = color(0.8, 0.8, 0.8, 1)
    local c2 = color(0.6, 0.6, 0.6, 1)
    for y = 0, math.ceil(size.y / square_size) - 1 do
        for x = 0, math.ceil(size.x / square_size) - 1 do
            local p = pos:add(vector2(x * square_size, y * square_size))
            local s = vector2(math.min(square_size, size.x - x * square_size), math.min(square_size, size.y - y * square_size))
            local current_c = (x + y) % 2 == 0 and c1 or c2
            render.add_rect_filled(p, p:add(s), current_c, 0)
        end
    end
end

local ElementMethods = {}
function ElementMethods:OnChanged(func) self.OnChangedFunc = func; return self end
function ElementMethods:SetTooltip(text) self.Tooltip = text; return self end

local function CreateElement(base, methods)
    if type(methods) == "table" then
        for k, v in pairs(methods) do base[k] = v end
    end
    return setmetatable(base, { __index = ElementMethods })
end

local ToggleMethods = {}
function ToggleMethods:SetValue(val)
    self.Value = val
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
end

local SliderMethods = {}
function SliderMethods:SetValue(val)
    local rounded_val = tonumber(string.format("%." .. (self.Rounding or 0) .. "f", val))
    self.Value = math.clamp(rounded_val, self.Min, self.Max)
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
end

local DropdownMethods = {}
function DropdownMethods:SetValue(val)
    self.Value = val
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
end

local InputMethods = {}
function InputMethods:SetValue(val)
    self.Value = val
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
end

local KeyPickerMethods = {}
function KeyPickerMethods:SetValue(val)
    self.Value = val
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
end

local ColorPickerMethods = {}
function ColorPickerMethods:SetValue(val)
    self.Value = val
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
    local h, s, v = rgb_to_hsv(val)
    self.Hue, self.Saturation, self.ValueHSV = h, s, v
    self.Alpha = val.a
end

function Library:CreateWindow(config)
    local window = {
        Title = config.Title or "Window",
        Pos = config.Center and vector2(get_screen_size().x / 2 - (config.Size.x / 2), get_screen_size().y / 2 - (config.Size.y / 2)) or vector2(175, 50),
        Size = config.Size or vector2(550, 600),
        Visible = config.AutoShow or false,
        Tabs = {},
        ActiveTab = nil,
    }

    function window:AddTab(name)
        local tab = { Name = name, Parent = window, Groupboxes = {} }
        function tab:AddLeftGroupbox(name, info) return self:AddGroupbox({ Name = name, Side = "Left", Dependencies = info and info.Dependencies or nil }) end
        function tab:AddRightGroupbox(name, info) return self:AddGroupbox({ Name = name, Side = "Right", Dependencies = info and info.Dependencies or nil }) end
        function tab:AddGroupbox(info)
            local groupbox = { Name = info.Name, Side = info.Side or "Left", Parent = tab, Elements = {}, Dependencies = info.Dependencies }
            function groupbox:IsVisible()
                if not self.Dependencies then return true end
                for _, dep in ipairs(self.Dependencies) do
                    if dep[1] and dep[1].Value ~= dep[2] then return false end
                end
                return true
            end

            function groupbox:AddToggle(id, info) local el=CreateElement({Id=id,Type="Toggle",Text=info.Text,Value=info.Default or false,Callback=info.Callback,Height=23, Tooltip=info.Tooltip, Risky=info.Risky},ToggleMethods);table.insert(self.Elements,el);Library.Toggles[id]=el;return el end
            function groupbox:AddSlider(id, info) local el=CreateElement({Id=id,Type="Slider",Text=info.Text,Value=info.Default or 0,Min=info.Min or 0,Max=info.Max or 100,Rounding=info.Rounding or 0,Suffix=info.Suffix or "",Callback=info.Callback,Height=42, Tooltip=info.Tooltip},SliderMethods);table.insert(self.Elements,el);Library.Options[id]=el;return el end
            function groupbox:AddButton(info) local el={Type="Button",Text=info.Text,Func=info.Func,Height=25, DoubleClick=info.DoubleClick, LastClick=0, Tooltip=info.Tooltip};table.insert(self.Elements,el);return el end
            function groupbox:AddDropdown(id, info) local el=CreateElement({Id=id,Type="Dropdown",Text=info.Text,Value=info.Default and info.Values[info.Default] or info.Values[1],Values=info.Values,Open=false,Callback=info.Callback,Height=40, Multi=info.Multi, Tooltip=info.Tooltip},DropdownMethods); if info.Multi then el.Value = info.Default or {} end; table.insert(self.Elements,el);Library.Options[id]=el;return el end
            function groupbox:AddInput(id, info) local el=CreateElement({Id=id,Type="Input",Text=info.Text,Value=info.Default or "",Placeholder=info.Placeholder or "",Callback=info.Callback,Height=40, Tooltip=info.Tooltip},InputMethods);table.insert(self.Elements,el);Library.Options[id]=el;return el end
            function groupbox:AddKeyPicker(id, info) local el=CreateElement({Id=id,Type="KeyPicker",Text=info.Text,Value=info.Default or "...",Callback=info.Callback,Picking=false,Height=40, Tooltip=info.Tooltip},KeyPickerMethods);table.insert(self.Elements,el);Library.Options[id]=el;return el end
            function groupbox:AddColorPicker(id, info) local val=info.Default or color(1,1,1,1); local h,s,v=rgb_to_hsv(val); local el=CreateElement({Id=id,Type="ColorPicker",Text=info.Text,Value=val,Open=false,Callback=info.Callback,Height=40,Hue=h,Saturation=s,ValueHSV=v,Alpha=val.a,EnableAlpha=info.EnableAlpha,Tooltip=info.Tooltip},ColorPickerMethods);table.insert(self.Elements,el);Library.Options[id]=el;return el end
            function groupbox:AddDivider(height) local el={Type="Divider", Height=height or 12};table.insert(self.Elements,el);return el end
            function groupbox:AddLabel(text) local el={Type="Label", Text=text, Height=20}; table.insert(self.Elements, el); return el end
            
            table.insert(self.Groupboxes, groupbox); return groupbox
        end
        table.insert(self.Tabs, tab)
        if not self.ActiveTab then self.ActiveTab = tab end
        return tab
    end
    table.insert(Library.Windows, window)
    return window
end

function Library:Notify(text, duration) table.insert(self.Notifications, { Text = text, Duration = duration or 5, StartTime = get_unixtime(), Alpha = 0, TargetAlpha = 1 }) end
function Library:SetWatermark(text) self.Watermark.Text = text; self.Watermark.Visible = true end

local function render_tooltip()
    if Library.Tooltip and Library.Tooltip.Text then
        local mouse_pos = input.get_mouse_position()
        local text_size = render.get_text_size(Library.Tooltip.Text)
        local tooltip_size = vector2(text_size.x + 10, text_size.y + 8)
        local tooltip_pos = mouse_pos:add(vector2(15, 15))
        
        render.add_rect_filled(tooltip_pos, tooltip_pos:add(tooltip_size), Library.MainColor, 2)
        render.add_rect(tooltip_pos, tooltip_pos:add(tooltip_size), Library.OutlineColor, 2, 1)
        render.add_text(tooltip_pos:add(vector2(5, 4)), Library.Tooltip.Text, Library.FontColor)
    end
end

hook.add("render", "linoria_photon_render", function()
    Library.Hue = (Library.Hue + 0.002) % 1
    Library.CurrentRainbowColor = hsv_to_rgb(Library.Hue, 0.8, 1)

    local function get_accent_color() if type(Library.AccentColor) == "function" then return Library.AccentColor() end; return Library.AccentColor end
    local accent = get_accent_color()

    local mouse_pos, mouse_pressed, mouse_down = input.get_mouse_position(), input.is_key_pressed(0x01), input.key_down(0x01)

    Library.ModalOpen = Library.OpenedDropdown or Library.ActiveColorPicker or Library.ActiveKeyPicker or Library.ActiveInput

    if mouse_pressed and (Library.OpenedDropdown or Library.ActiveColorPicker or Library.ActiveKeyPicker or Library.ActiveInput) then
        if Library.OpenedDropdown and not (is_mouse_in_rect(Library.OpenedDropdown.Layout.pos, Library.OpenedDropdown.Layout.size) or is_mouse_in_rect(Library.OpenedDropdown.Layout.list_pos, Library.OpenedDropdown.Layout.list_size)) then
            Library.OpenedDropdown.Open = false; Library.OpenedDropdown = nil
        end
        if Library.ActiveColorPicker and not is_mouse_in_rect(Library.ActiveColorPicker.layout.picker_pos, Library.ActiveColorPicker.layout.picker_size) then
            Library.ActiveColorPicker.obj.Open = false; Library.ActiveColorPicker = nil
        end
        if Library.ActiveKeyPicker and not is_mouse_in_rect(Library.ActiveKeyPicker.layout.pos, Library.ActiveKeyPicker.layout.size) then
            Library.ActiveKeyPicker.obj.Picking = false; Library.ActiveKeyPicker = nil
        end
        if Library.ActiveInput and not is_mouse_in_rect(Library.ActiveInput.layout.pos, Library.ActiveInput.layout.size) then
            Library.ActiveInput = nil
        end
    end
    
    if Library.DraggingWindow then if mouse_down then Library.DraggingWindow.Pos = mouse_pos:subtract(Library.DragOffset) else Library.DraggingWindow = nil end end
    if Library.ActiveSlider then if mouse_down then local s, l = Library.ActiveSlider.obj, Library.ActiveSlider.layout; local r = (math.clamp(mouse_pos.x, l.pos.x, l.pos.x + l.size.x) - l.pos.x) / l.size.x; local v = s.Min + (s.Max - s.Min) * r; if s.Value ~= v then s:SetValue(v) end else Library.ActiveSlider = nil end end
    
    if Library.ActiveColorPicker and mouse_down then
        local cp = Library.ActiveColorPicker.obj; local layout = Library.ActiveColorPicker.layout
        if is_mouse_in_rect(layout.sv_pos, layout.sv_size) then
            cp.Saturation = math.clamp((mouse_pos.x - layout.sv_pos.x) / layout.sv_size.x, 0, 1)
            cp.ValueHSV = 1 - math.clamp((mouse_pos.y - layout.sv_pos.y) / layout.sv_size.y, 0, 1)
            cp:SetValue(hsv_to_rgb(cp.Hue, cp.Saturation, cp.ValueHSV, cp.Alpha))
        elseif is_mouse_in_rect(layout.hue_pos, layout.hue_size) then
            cp.Hue = math.clamp((mouse_pos.y - layout.hue_pos.y) / layout.hue_size.y, 0, 1)
            cp:SetValue(hsv_to_rgb(cp.Hue, cp.Saturation, cp.ValueHSV, cp.Alpha))
        elseif cp.EnableAlpha and is_mouse_in_rect(layout.alpha_pos, layout.alpha_size) then
            cp.Alpha = math.clamp((mouse_pos.x - layout.alpha_pos.x) / layout.alpha_size.x, 0, 1)
            cp:SetValue(hsv_to_rgb(cp.Hue, cp.Saturation, cp.ValueHSV, cp.Alpha))
        end
    end

    local watermark_size = vector2(render.get_text_size(Library.Watermark.Text).x + 10, 20)
