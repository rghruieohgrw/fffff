                                if is_mouse_in_rect(element_pos, element_full_width_size) and element.Tooltip then Library.Tooltip = { Text = element.Tooltip, Element = element } end

                                if element.Type == "Toggle" then
                                    local toggle_box_pos = element_pos:add(vector2(0,4))
                                    render.add_rect(toggle_box_pos, toggle_box_pos:add(vector2(13, 13)), Library.OutlineColor, 0, 1)
                                    if element.Value then render.add_rect_filled(toggle_box_pos:add(vector2(2, 2)), toggle_box_pos:add(vector2(11, 11)), accent, 0) end
                                    render.add_text(element_pos:add(vector2(19, 3)), element.Text, element.Risky and Library.RiskColor or Library.FontColor)
                                    if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(element_pos, vector2(150, 13)) and can_interact then element:SetValue(not element.Value) end
                                elseif element.Type == "Slider" then
                                    local s_pos, s_size = element_pos:add(vector2(0, 20)), vector2(group_size.x - 8, 13)
                                    render.add_text(element_pos, element.Text, Library.FontColor)
                                    render.add_rect(s_pos, s_pos:add(s_size), Library.OutlineColor, 0, 1)
                                    render.add_rect_filled(s_pos:add(vector2(1, 1)), s_pos:add(s_size):subtract(vector2(1, 1)), Library.MainColor, 0)
                                    render.add_rect_filled(s_pos:add(vector2(1, 1)), s_pos:add(vector2(s_size.x * ((element.Value - element.Min) / (element.Max - element.Min)), s_size.y - 1)), accent, 0)
                                    local val_text = tostring(element.Value) .. element.Suffix
                                    render.add_text(s_pos:add(vector2(s_size.x / 2 - render.get_text_size(val_text).x / 2, -1)), val_text, Library.FontColor)
                                    if not Library.DraggingWindow and not Library.ActiveSlider and mouse_pressed and is_mouse_in_rect(s_pos, s_size) and can_interact then Library.ActiveSlider = { obj = element, layout = { pos = s_pos, size = s_size } } end
                                elseif element.Type == "Button" then
                                    local b_pos, b_size = element_pos, vector2(group_size.x - 8, 20)
                                    render.add_rect(b_pos, b_pos:add(b_size), Library.OutlineColor, 0, 1)
                                    render.add_rect_filled(b_pos:add(vector2(1, 1)), b_pos:add(b_size):subtract(vector2(1, 1)), is_mouse_in_rect(b_pos, b_size) and not mouse_down and accent or Library.MainColor, 0)
                                    local text_to_render = element.Text
                                    if element.DoubleClick and get_unixtime() - element.LastClick < 1 and element.LastClick ~= 0 then text_to_render = "Confirm?" end
                                    local clip_text = get_clipped_text(text_to_render, b_size.x - 10)
                                    render.add_text(b_pos:add(vector2(b_size.x / 2 - render.get_text_size(clip_text).x / 2, 2)), clip_text, Library.FontColor)
                                    if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(b_pos, b_size) and can_interact then 
                                        if element.DoubleClick then
                                            if get_unixtime() - element.LastClick < 1 then
                                                if element.Func then element.Func() end
                                                element.LastClick = 0
                                            else
                                                element.LastClick = get_unixtime()
                                            end
                                        else
                                            if element.Func then element.Func() end
                                        end
                                    end
                                elseif element.Type == "Dropdown" then
                                    render.add_text(element_pos, element.Text, Library.FontColor)
                                    local d_pos, d_size = element_pos:add(vector2(0, 15)), vector2(group_size.x - 8, 20)
                                    element.Layout = { pos = d_pos, size = d_size }
                                    render.add_rect(d_pos, d_pos:add(d_size), Library.OutlineColor, 0, 1)
                                    render.add_rect_filled(d_pos:add(vector2(1, 1)), d_pos:add(d_size):subtract(vector2(1, 1)), Library.MainColor, 0)
                                    local display_text
                                    if element.Multi then
                                        local selected = {}
                                        for k,v in pairs(element.Value) do if v then table.insert(selected, k) end end
                                        display_text = #selected > 0 and table.concat(selected, ", ") or "None"
                                    else
                                        display_text = tostring(element.Value)
                                    end
                                    render.add_text(d_pos:add(vector2(5, 2)), get_clipped_text(display_text, d_size.x-20), Library.FontColor)
                                    render.add_triangle_filled(d_pos:add(vector2(d_size.x-10, 7)), d_pos:add(vector2(d_size.x-4, 7)), d_pos:add(vector2(d_size.x-7, 13)), Library.FontColor)
                                    if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(d_pos, d_size) and can_interact then element.Open = not element.Open; Library.OpenedDropdown = element.Open and element or nil end
                                elseif element.Type == "Input" then
                                    render.add_text(element_pos, element.Text, Library.FontColor)
                                    local i_pos, i_size = element_pos:add(vector2(0, 15)), vector2(group_size.x - 8, 20)
                                    element.layout = {pos = i_pos, size = i_size}
                                    local is_active = Library.ActiveInput == element
                                    render.add_rect(i_pos, i_pos:add(i_size), is_active and accent or Library.OutlineColor, 0, 1)
                                    render.add_rect_filled(i_pos:add(vector2(1, 1)), i_pos:add(i_size):subtract(vector2(1, 1)), Library.MainColor, 0)
                                    local d_text = #element.Value > 0 and element.Value or element.Placeholder
                                    local text_color = #element.Value > 0 and Library.FontColor or color(0.5, 0.5, 0.5, 1)
                                    render.add_text(i_pos:add(vector2(5, 2)), get_clipped_text(d_text, i_size.x - 10), text_color)
                                    if is_active and (math.floor(get_unixtime() * 2) % 2 == 0) then
                                        local text_width = render.get_text_size(get_clipped_text(element.Value, i_size.x - 10)).x
                                        render.add_line(i_pos:add(vector2(5 + text_width, 4)), i_pos:add(vector2(5 + text_width, i_size.y - 4)), Library.FontColor, 1)
                                    end
                                    if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(i_pos, i_size) then Library.ActiveInput = element end
                                elseif element.Type == "KeyPicker" then
                                    render.add_text(element_pos, element.Text, Library.FontColor)
                                    local k_pos, k_size = element_pos:add(vector2(0, 15)), vector2(group_size.x - 8, 20)
                                    element.layout = {pos = k_pos, size = k_size}
                                    render.add_rect(k_pos, k_pos:add(k_size), (element.Picking and accent) or Library.OutlineColor, 0, 1)
                                    render.add_rect_filled(k_pos:add(vector2(1, 1)), k_pos:add(k_size):subtract(vector2(1, 1)), Library.MainColor, 0)
                                    local text = element.Picking and "..." or ("["..element.Value.."]")
                                    render.add_text(k_pos:add(vector2(k_size.x/2 - render.get_text_size(text).x/2, 2)), text, Library.FontColor)
                                    if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(k_pos, k_size) and can_interact then element.Picking = true; Library.ActiveKeyPicker = {obj=element, layout=element.layout} end
                                elseif element.Type == "ColorPicker" then
                                    render.add_text(element_pos, element.Text, Library.FontColor)
                                    local c_pos, c_size = element_pos:add(vector2(0, 15)), vector2(group_size.x - 8, 20)
                                    element.layout = { pos = c_pos, size = c_size }
                                    render.add_rect(c_pos, c_pos:add(c_size), Library.OutlineColor, 0, 1)
                                    if element.EnableAlpha then draw_checkerboard(c_pos:add(vector2(1,1)), c_size:subtract(vector2(2,2)), 4) end
                                    render.add_rect_filled(c_pos:add(vector2(1,1)), c_pos:add(c_size):subtract(vector2(1,1)), element.Value, 0)
                                    if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(c_pos, c_size) and can_interact then element.Open = not element.Open; Library.ActiveColorPicker = element.Open and {obj=element, layout=element.layout} or nil end
                                elseif element.Type == "Divider" then
                                    local div_y = element_pos.y + element.Height/2
                                    render.add_line(vector2(element_pos.x, div_y), vector2(element_pos.x + group_size.x - 8, div_y), Library.OutlineColor, 1)
                                elseif element.Type == "Label" then
                                    render.add_text(element_pos:add(vector2(0,3)), element.Text, Library.FontColor)
                                end
                                element_y = element_y + element.Height
                            end
                            if groupbox.Side == "Left" then left_y = left_y + group_size.y + 12 else right_y = right_y + group_size.y + 12 end
                        end
                    end
                end
            end
        end
    end

    if Library.OpenedDropdown then
        local e = Library.OpenedDropdown
        local list_pos = e.Layout.pos:add(vector2(0, e.Layout.size.y + 1))
        local list_height = math.min(#e.Values, 6) * 20 + 2
        local list_size = vector2(e.Layout.size.x, list_height)
        e.Layout.list_pos, e.Layout.list_size = list_pos, list_size
        
        render.add_rect_filled(list_pos, list_pos:add(list_size), Library.MainColor, 2)
        render.add_rect(list_pos, list_pos:add(list_size), Library.OutlineColor, 2, 1)
        
        local item_y = 1
        for _, value in ipairs(e.Values) do
            local item_pos, item_size = list_pos:add(vector2(1, item_y)), vector2(list_size.x - 2, 20)
            local is_selected = (e.Multi and e.Value[value]) or (e.Value == value)
            local text_color = is_selected and accent or Library.FontColor
            
            if is_mouse_in_rect(item_pos, item_size) then
                render.add_rect_filled(item_pos, item_pos:add(item_size), accent, 0)
                text_color = Library.FontColor
                if mouse_pressed then
                    if e.Multi then 
                        e.Value[value] = not e.Value[value] 
                        e:SetValue(e.Value)
                    else 
                        e:SetValue(value); 
                        e.Open = false; 
                        Library.OpenedDropdown = nil 
                    end
                end
            end
            render.add_text(item_pos:add(vector2(4, 2)), value, text_color)
            item_y = item_y + 20
        end
    end

    if Library.ActiveColorPicker then
        local e = Library.ActiveColorPicker.obj
        local picker_size = e.EnableAlpha and vector2(150, 195) or vector2(150, 170)
        local picker_pos = e.layout.pos:add(vector2(0, e.layout.size.y + 1))
        e.layout.picker_pos, e.layout.picker_size = picker_pos, picker_size

        render.add_rect_filled(picker_pos, picker_pos:add(picker_size), Library.MainColor, 2)
        render.add_rect(picker_pos, picker_pos:add(picker_size), Library.OutlineColor, 2, 1)
        
        local sv_size, hue_size = vector2(120, 120), vector2(15, 120)
        local sv_pos = picker_pos:add(vector2(5,5))
        local hue_pos = picker_pos:add(vector2(130,5))
        e.layout.sv_pos, e.layout.sv_size, e.layout.hue_pos, e.layout.hue_size = sv_pos, sv_size, hue_pos, hue_size

        local hue_color = hsv_to_rgb(e.Hue, 1, 1)
        render.add_rect_filled(sv_pos, sv_pos:add(sv_size), color(1, 1, 1, 1), 0)
        for i=0, sv_size.x-1 do render.add_line(sv_pos:add(vector2(i,0)), sv_pos:add(vector2(i, sv_size.y)), color(hue_color.r, hue_color.g, hue_color.b, i/sv_size.x), 1) end
        for i=0, sv_size.y-1 do render.add_line(sv_pos:add(vector2(0,i)), sv_pos:add(vector2(sv_size.x, i)), color(0,0,0,i/sv_size.y), 1) end
        render.add_rect(sv_pos, sv_pos:add(sv_size), Library.Black, 0, 1)

        for i=0,hue_size.y-1 do render.add_line(hue_pos:add(vector2(0,i)), hue_pos:add(vector2(hue_size.x, i)), hsv_to_rgb(i/hue_size.y, 1, 1), 1) end
        render.add_rect(hue_pos, hue_pos:add(hue_size), Library.Black, 0, 1)
        
        local cursor_x = sv_pos.x + sv_size.x * e.Saturation
        local cursor_y = sv_pos.y + sv_size.y * (1 - e.ValueHSV)
        render.add_circle(vector2(cursor_x, cursor_y), 4, e.ValueHSV > 0.5 and color(0,0,0,1) or color(1,1,1,1), 1)

        local hue_cursor_y = hue_pos.y + hue_size.y * e.Hue
        render.add_rect(vector2(hue_pos.x-2, hue_cursor_y-1), vector2(hue_pos.x+hue_size.x+2, hue_cursor_y+1), color(1,1,1,1),0,1)

        local preview_pos, preview_size = picker_pos:add(vector2(5, 130)), vector2(120, 35)
        draw_checkerboard(preview_pos, preview_size, 5)
        render.add_rect_filled(preview_pos, preview_pos:add(preview_size), e.Value, 0)
        render.add_rect(preview_pos, preview_pos:add(preview_size), Library.Black, 0, 1)
        
        if e.EnableAlpha then
            local alpha_pos, alpha_size = picker_pos:add(vector2(5, 170)), vector2(120, 15)
            e.layout.alpha_pos, e.layout.alpha_size = alpha_pos, alpha_size
            draw_checkerboard(alpha_pos, alpha_size, 5)
            local solid_color = hsv_to_rgb(e.Hue, e.Saturation, e.ValueHSV)
            for i=0,alpha_size.x-1 do
                render.add_line(alpha_pos:add(vector2(i,0)), alpha_pos:add(vector2(i, alpha_size.y)), color(solid_color.r, solid_color.g, solid_color.b, i/alpha_size.x), 1)
            end
            render.add_rect(alpha_pos, alpha_pos:add(alpha_size), Library.Black, 0, 1)
            local alpha_cursor_x = alpha_pos.x + alpha_size.x * e.Alpha
            render.add_rect(vector2(alpha_cursor_x-1, alpha_pos.y-2), vector2(alpha_cursor_x+1, alpha_pos.y+alpha_size.y+2), color(1,1,1,1),0,1)
        end
    end
    
    local notification_y = 40
    for i = #Library.Notifications, 1, -1 do
        local notif = Library.Notifications[i]
        local time_passed = get_unixtime() - notif.StartTime
        if time_passed > notif.Duration then notif.TargetAlpha = 0 end
        
        notif.Alpha = notif.Alpha + (notif.TargetAlpha - notif.Alpha) * 0.1
        if notif.TargetAlpha == 0 and notif.Alpha < 0.01 then table.remove(Library.Notifications, i) else
            local notif_size = vector2(render.get_text_size(notif.Text).x + 15, 20)
            local notif_pos = vector2(10, notification_y)
            
            render.add_rect(notif_pos, notif_pos:add(notif_size), color(Library.OutlineColor.r, Library.OutlineColor.g, Library.OutlineColor.b, notif.Alpha), 0, 1)
            render.add_rect_filled(notif_pos:add(vector2(1, 1)), notif_pos:add(notif_size):subtract(vector2(1, 1)), color(Library.MainColor.r, Library.MainColor.g, Library.MainColor.b, notif.Alpha), 0)
            render.add_rect_filled(notif_pos, notif_pos:add(vector2(3, notif_size.y)), color(accent.r, accent.g, accent.b, notif.Alpha), 0)
            render.add_text(notif_pos:add(vector2(8, 2)), notif.Text, color(Library.FontColor.r, Library.FontColor.g, Library.FontColor.b, notif.Alpha))
            
            notification_y = notification_y + notif_size.y + 4
        end
    end
    
    if Library.Watermark.Visible then
        local pos, size = Library.Watermark.Pos, watermark_size
        local darker_main = color(Library.MainColor.r * 0.7, Library.MainColor.g * 0.7, Library.MainColor.b * 0.7, 1)

        render.add_rect(pos, pos:add(size), Library.Black, 0, 1)
        render.add_rect(pos:add(vector2(1,1)), pos:add(size):subtract(vector2(1,1)), accent, 0, 1)
        
        local grad_start_pos = pos:add(vector2(2,2))
        local grad_size = size:subtract(vector2(4,4))
        for i = 0, grad_size.y - 1 do
            local lerp_factor = i / (grad_size.y - 1)
            local line_color = color(darker_main.r+(Library.MainColor.r-darker_main.r)*lerp_factor,darker_main.g+(Library.MainColor.g-darker_main.g)*lerp_factor,darker_main.b+(Library.MainColor.b-darker_main.b)*lerp_factor,1)
            render.add_line(grad_start_pos:add(vector2(0, i)), grad_start_pos:add(vector2(grad_size.x, i)), line_color, 1)
        end

        render.add_text(pos:add(vector2(5, 2)), Library.Watermark.Text, Library.FontColor)
    end
    
    render_tooltip()
end)

hook.add("init", "linoria_key_handler_init", function()
    hook.addkey(0, "linoria_key_handler", function(key)
        if Library.ActiveKeyPicker then
            local key_name = KEY_NAMES[key]
            if key_name then
                Library.ActiveKeyPicker.obj:SetValue(key_name)
                Library.ActiveKeyPicker.obj.Picking = false
                Library.ActiveKeyPicker = nil
                Library:Notify("Key bound to " .. key_name)
            end
            return
        end

        if Library.ActiveInput then
            if key == 0x08 then
                local val = Library.ActiveInput.Value
                if #val > 0 then
                    Library.ActiveInput:SetValue(string.sub(val, 1, -2))
                end
            else
                local is_shift_down = input.key_down(0x10)
                local char = (is_shift_down and CHAR_MAP_SHIFT[key]) or CHAR_MAP_NORMAL[key]
                if char then
                    Library.ActiveInput:SetValue(Library.ActiveInput.Value .. char)
                end
            end
        end
    end)
end)
